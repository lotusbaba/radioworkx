RADIO_PORT=8000
SESSION_SECRET=replace-with-a-long-random-string
# Set to 1 when accessed over HTTPS through Tailscale Serve.
COOKIE_SECURE=0
REACTION_THRESHOLD=20
# Exact hostnames of your authorized HTTPS audio sources; no wildcard matching.
DOWNLOAD_HOSTS=
# Optional: generated tones using fictional artists, never represented as Bandcamp recordings.
DEMO_MODE=0

# Use /data/live to keep real station state separate from a previous demo.
RADIO_DATA_DIR=/data
REDIS_DB=0
QUEUE_PREFIX=radio

# Backend-only conversational RAG; leave empty to use basic catalog search.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_CHAT_DAILY_LIMIT=500

# AI-generated male voice before each song, using the server-side OpenAI key.
ANNOUNCER_ENABLED=1
ANNOUNCER_MODEL=gpt-4o-mini-tts
ANNOUNCER_VOICE=onyx

# Public-source metadata crawler (SQS queue + independent consumer).
CRAWLER_ENABLED=1
CRAWLER_PAGE_BUDGET=20

# Announcement gain (0–12 dB), peak limited.
ANNOUNCER_GAIN_DB=6

# Separate /admin dashboard; username admin. Set a strong password.
ADMIN_PASSWORD=

# Cached artwork video worker; OpenAI Sora API retires 2026-09-24.
VIDEOS_ENABLED=1
VIDEO_MODEL=sora-2
MEDIA_BUCKET=radioworkx-media

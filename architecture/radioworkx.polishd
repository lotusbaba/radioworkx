// Source-derived architecture snapshot, 2026-10-01; not a live deployment audit.
// No credentials, private endpoints, or measured-capacity claims.
// Separate compute pools represent container roles, not separate physical machines.
architecture RadioWorkx {
  role Admin
  gateway Funnel { tls = true tls_termination = true upstream_protocol = http routes_to Proxy }
  load_balancer Proxy { supports_streaming = true response_buffering = false routes_to API }
  compute_pool ApiContainer { instances = 1 }
  compute_pool StationContainer { instances = 1 }
  compute_pool WorkerContainers { instances = 1 }
  compute_pool RedisContainer { instances = 1 }
  compute_pool IngestContainers { instances = 1 }
  compute_pool DashboardContainers { instances = 1 }

  frontend Site {
    rendering = server loaded_from API
    page Home
    page Library
    page MyMusic
    page AdminPage { requires role Admin }
    Home navigates_to Library
    Home navigates_to MyMusic
    Home navigates_to AdminPage
    Home invokes API.live
    Home invokes API.search
    Home invokes API.reaction
  }
  volume Media { storage = persistent }
  volume TelemetryFiles { storage = persistent }
  database State {
    kind = relational hosted_on Postgres
    table Tracks
    table Users
    table Sessions
    table Playlists
    table Plays
    table Reactions
    table Requests
    table Outbox
    table Jobs
    table MediaObjects
    table Embeddings
  }
  database_cluster Postgres { provider = self_hosted product = postgres }
  cache RedisState { provider = self_hosted product = redis hosted_on RedisContainer }
  stream Audio {
    provider = self_hosted product = redis_stream hosted_on RedisContainer retention_messages = 160
  }
  stream Events {
    provider = self_hosted product = redis_stream hosted_on RedisContainer retention_messages = 2000
  }
  artifact_store Objects { provider = localstack product = s3 }
  queue ReactionJobs { provider = localstack product = sqs queue_type = standard visibility_timeout_seconds = 60 }
  queue DownloadJobs { provider = localstack product = sqs queue_type = standard visibility_timeout_seconds = 900 }
  queue CrawlJobs { provider = localstack product = sqs queue_type = standard visibility_timeout_seconds = 900 }
  queue VisualJobs { provider = localstack product = sqs queue_type = standard visibility_timeout_seconds = 900 }
  external_service LanguageAPI { tls = true }
  external_service SpeechAPI { tls = true }
  external_service VisualAPI { tls = true }
  external_service LicensedSources { tls = true }

  service API {
    hosted_on ApiContainer
    mounts Media { access = read_write }
    operation home { method = GET path = "/" }
    operation search { method = GET path = "/api/library/search" reads State.Tracks }
    operation live { method = GET path = "/api/live" requires authenticated consumes_from Audio }
    operation events { method = GET path = "/api/events" reads State.Plays reads RedisState consumes_from Events }
    operation reaction { method = POST path = "/api/reactions" requires authenticated writes State.Reactions writes State.Outbox }
    operation chat { method = POST path = "/api/requests" requires authenticated reads State.Tracks reads State.Embeddings invokes LanguageAPI { protocol = https } writes State.Requests }
    operation music { method = GET path = "/api/me/music" requires authenticated reads State.Playlists }
    operation media { method = GET path = "/api/listen/*/audio" reads Media }
    operation activity { method = GET path = "/api/admin/activity" requires role Admin reads ElasticEvents.Entries { protocol = http } }
  }
  service Dispatcher {
    hosted_on WorkerContainers
    operation dispatch {
      method = POST path = "/dispatch" reads State.Outbox
      publishes_to ReactionJobs publishes_to DownloadJobs publishes_to CrawlJobs publishes_to VisualJobs
      writes State.Outbox
    }
  }
  service ReactionWorker {
    hosted_on WorkerContainers
    operation process {
      method = POST path = "/work" consumes_from ReactionJobs reads State.Outbox
      writes RedisState writes State.Jobs publishes_to Events
    }
  }
  service Downloads {
    hosted_on WorkerContainers mounts Media { access = read_write }
    operation process {
      method = POST path = "/download" consumes_from DownloadJobs reads State.Outbox
      invokes LicensedSources { protocol = https } writes Media writes State.Tracks writes State.Jobs
    }
  }
  service Crawler {
    hosted_on WorkerContainers
    operation process { method = POST path = "/crawl" consumes_from CrawlJobs invokes LicensedSources { protocol = https } writes State.Tracks writes State.Outbox }
  }
  service Visuals {
    hosted_on WorkerContainers mounts Media { access = read_write }
    operation process { method = POST path = "/visual" consumes_from VisualJobs invokes VisualAPI { protocol = https } writes Media writes Objects writes State.MediaObjects }
    operation restore { method = POST path = "/restore" reads Objects writes Media }
  }
  service Station {
    hosted_on StationContainer mounts Media { access = read_write }
    operation broadcast { method = POST path = "/broadcast" reads State.Tracks reads State.Playlists reads Media writes State.Plays publishes_to Audio publishes_to Events }
    operation announce { method = POST path = "/announce" invokes SpeechAPI { protocol = https } writes Media }
  }
  // These are independent background pipelines, deliberately not synchronous API dependencies.
  service TelemetryWriter {
    hosted_on WorkerContainers mounts TelemetryFiles { access = read_write }
    operation flush { method = POST path = "/flush" writes TelemetryFiles }
  }
  service Logstash {
    hosted_on IngestContainers mounts TelemetryFiles { access = read_only }
    operation ingest { method = POST path = "/ingest" reads TelemetryFiles writes ElasticEvents.Entries { protocol = http } }
  }
  service OpenSearchIngest {
    hosted_on IngestContainers mounts TelemetryFiles { access = read_only }
    operation ingest { method = POST path = "/ingest" reads TelemetryFiles writes SearchEvents.Entries { protocol = http } }
  }
  database ElasticEvents { kind = document hosted_on Elasticsearch collection Entries }
  database_cluster Elasticsearch { provider = self_hosted product = elasticsearch }
  database SearchEvents { kind = document hosted_on OpenSearch collection Entries }
  database_cluster OpenSearch { provider = self_hosted product = opensearch }
  service Kibana {
    hosted_on DashboardContainers
    operation view { method = GET path = "/" reads ElasticEvents.Entries { protocol = http } }
  }
  service Dashboards {
    hosted_on DashboardContainers
    operation view { method = GET path = "/" reads SearchEvents.Entries { protocol = http } }
  }
}
scenario "Load home through TLS and proxy" {
  request { entry = Funnel protocol = https path = "/" }
  expect { outcome = success reaches API.home }
}
scenario "Search reads PostgreSQL catalog" {
  request { entry = Funnel protocol = https path = "/api/library/search" }
  expect { outcome = success accesses State.Tracks }
}
scenario "Listener joins shared audio" {
  request { entry = Funnel protocol = https path = "/api/live" authenticated = true }
  expect { outcome = success reaches Audio reaches RedisContainer }
}
scenario "SSE reads separate broadcast stream" {
  request { entry = Funnel protocol = https path = "/api/events" cache_result = hit }
  expect { outcome = success reaches Events }
}
scenario "Reaction persists to outbox before background dispatch" {
  request { entry = Funnel protocol = https method = POST path = "/api/reactions" authenticated = true }
  expect { outcome = success accesses State.Outbox }
}
scenario "Dispatcher sends durable work to local queues" {
  request { entry = Dispatcher protocol = http method = POST path = "/dispatch" }
  expect { outcome = success reaches ReactionJobs reaches DownloadJobs reaches CrawlJobs reaches VisualJobs }
}
scenario "Reaction worker updates Redis and emits event" {
  request { entry = ReactionWorker protocol = http method = POST path = "/work" cache_result = hit }
  expect { outcome = success reaches Events accesses RedisState }
}
scenario "Station broadcasts saved audio independently of listener count" {
  request { entry = Station protocol = http method = POST path = "/broadcast" }
  expect { outcome = success reaches Audio accesses Media }
}
scenario "Object restore writes mounted media" {
  request { entry = Visuals protocol = http method = POST path = "/restore" }
  expect { outcome = success accesses Objects accesses Media }
}
scenario "Chat invokes external provider" {
  request { entry = Funnel protocol = https method = POST path = "/api/requests" authenticated = true }
  expect { outcome = success reaches LanguageAPI }
}
scenario "Guest cannot query admin telemetry" {
  request { entry = Funnel protocol = https path = "/api/admin/activity" }
  expect { outcome = denied }
}
scenario "Admin can query Elasticsearch" {
  request { entry = Funnel protocol = https path = "/api/admin/activity" actor = Admin authenticated = true }
  expect { outcome = success accesses ElasticEvents.Entries }
}
scenario "Telemetry indexing is separate from playback" {
  request { entry = OpenSearchIngest protocol = http method = POST path = "/ingest" }
  expect { outcome = success accesses TelemetryFiles accesses SearchEvents.Entries }
}
